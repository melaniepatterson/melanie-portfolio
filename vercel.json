{
  "redirects": [
    { "source": "/routine", "destination": "https://glowup.melanie.studio/", "permanent": false },
    { "source": "/routine/:path*", "destination": "https://glowup.melanie.studio/:path*", "permanent": false }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
